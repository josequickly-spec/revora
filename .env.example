# Base de Datos PostgreSQL (Supabase)
# Obtén esto en: https://app.supabase.com > Settings > Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Autenticación (Clerk)
# Obtén esto en: https://dashboard.clerk.com > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Email (Resend)
# Obtén esto en: https://app.resend.com > API Keys
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="verified-sender@example.com"

# Phase 6 Outreach Automation (server-only; generate strong random values)
OUTREACH_WORKER_SECRET="replace-with-a-long-random-secret"
OUTREACH_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Validación de Emails (Opcional - Hunter.io)
# Obtén esto en: https://hunter.io/api > API Reference
HUNTER_API_KEY="xxx"
