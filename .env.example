# Core
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
APP_URL=http://localhost:3000
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ENCRYPTION_KEY=replace-with-at-least-32-different-random-characters
TRUST_PROXY=false

# Optional bot protection for public auth and lead-search forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Workers and signed ingestion
WORKFLOW_WORKER_SECRET=replace-with-at-least-32-random-characters
# Preferred dedicated secret. CRON_SECRET is used as a fallback when omitted.
OUTREACH_WORKER_SECRET=replace-with-at-least-32-random-characters
OUTREACH_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_INGEST_SECRET=replace-with-at-least-32-random-characters
GOOGLE_ADS_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
RESEND_WEBHOOK_SECRET=whsec_replace-with-provider-secret
META_WEBHOOK_SECRET=replace-with-provider-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-verification-token
CRON_SECRET=replace-with-at-least-32-random-characters
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters

# AI and enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CONSULTANT_MODEL=gpt-5.6-terra
OPENAI_EXECUTIVE_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Set to false only when troubleshooting cache behavior.
ANTHROPIC_PROMPT_CACHE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional comma-separated global fallback order.
AI_PROVIDER_ORDER=
HUNTER_API_KEY=
BUILTWITH_API_KEY=
BUILTWITH_API_TIER=free
PARSEHUB_API_KEY=
PARSEHUB_PROJECT_TOKEN=
PARSEHUB_WEBHOOK_SECRET=
GOOGLE_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AUTH_EMAIL_FROM=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Billing and advertising
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=

# Cache and observability
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_ALLOW_LOCAL_FALLBACK=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
